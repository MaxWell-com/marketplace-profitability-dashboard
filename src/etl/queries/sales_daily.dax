// 1C E-comm sales by day and partner (document date not later than today)
EVALUATE
SUMMARIZECOLUMNS(
    'Спр - Календарь'[Дата], 'Спр - Структура предприятия'[Подразделение], 'Спр - Партнеры'[Партнер],
    FILTER(ALL('Спр - Календарь'[Дата]), 'Спр - Календарь'[Дата] >= DATE(2025,1,1) && 'Спр - Календарь'[Дата] <= TODAY()),
    KEEPFILTERS(FILTER(ALL('Спр - Структура предприятия'[Подразделение]), LEFT('Спр - Структура предприятия'[Подразделение], 6) = "E-comm")),
    "rev", [# Выручка], "qty", [# Количество]
)
