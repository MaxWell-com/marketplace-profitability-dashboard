// Marketplace charges by 1C code: revenue, units, all other charges
EVALUATE
FILTER(
SUMMARIZECOLUMNS(
    'Спр - Календарь'[Год], 'Спр - Календарь'[Порядковый номер Месяца],
    'Спр - ecom - Маркетплейсы'[Маркетплейс], 'Спр - Номенклатура'[Код],
    "rev", CALCULATE(SUM('Факт - ecom - Ежедневный финансовый отчет'[Сумма начисления]), 'Факт - ecom - Ежедневный финансовый отчет'[Статья расходов] = "Выручка"),
    "qty", CALCULATE(SUM('Факт - ecom - Ежедневный финансовый отчет'[Количество sku]), 'Факт - ecom - Ежедневный финансовый отчет'[Статья расходов] = "Выручка"),
    "cost", CALCULATE(SUM('Факт - ecom - Ежедневный финансовый отчет'[Сумма начисления]), 'Факт - ecom - Ежедневный финансовый отчет'[Статья расходов] <> "Выручка")
), NOT ISBLANK([Код]))
