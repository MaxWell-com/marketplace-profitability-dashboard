// Revenue from marketplace reports (sales to end customers) by day
EVALUATE
SUMMARIZECOLUMNS(
    'Спр - Календарь'[Дата], 'Спр - ecom - Маркетплейсы'[Маркетплейс],
    FILTER(ALL('Спр - Календарь'[Дата]), 'Спр - Календарь'[Дата] >= DATE(2025,1,1)),
    "rev", CALCULATE(SUM('Факт - ecom - Ежедневный финансовый отчет'[Сумма начисления]), 'Факт - ecom - Ежедневный финансовый отчет'[Статья расходов] = "Выручка")
)
