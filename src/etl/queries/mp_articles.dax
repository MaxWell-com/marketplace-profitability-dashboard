// Marketplace charges: month x marketplace x seller account x article x charge kind (raw amount, no predefined measures)
EVALUATE
SUMMARIZECOLUMNS(
    'Спр - Календарь'[Год], 'Спр - Календарь'[Порядковый номер Месяца],
    'Спр - ecom - Маркетплейсы'[Маркетплейс], 'Спр - ecom - Личные кабинеты маркетплейсов'[Личный кабинет маркетплейса],
    'Факт - ecom - Ежедневный финансовый отчет'[Порядковый номер Статьи расходов], 'Факт - ecom - Ежедневный финансовый отчет'[Статья расходов], 'Факт - ecom - Ежедневный финансовый отчет'[Вид начислений],
    "amount", SUM('Факт - ecom - Ежедневный финансовый отчет'[Сумма начисления]),
    "amount_mapped", CALCULATE(SUM('Факт - ecom - Ежедневный финансовый отчет'[Сумма начисления]), NOT ISBLANK('Факт - ecom - Ежедневный финансовый отчет'[FK | Номенклатура]))
)
