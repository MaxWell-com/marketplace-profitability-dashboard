// 1C sales of E-comm divisions: month x division x partner x code
EVALUATE
SUMMARIZECOLUMNS(
    'Спр - Календарь'[Год], 'Спр - Календарь'[Порядковый номер Месяца],
    'Спр - Структура предприятия'[Подразделение], 'Спр - Партнеры'[Партнер], 'Спр - Номенклатура'[Код],
    FILTER(ALL('Спр - Календарь'[Дата]), 'Спр - Календарь'[Дата] >= DATE(2024,1,1) && 'Спр - Календарь'[Дата] <= TODAY()),
    KEEPFILTERS(FILTER(ALL('Спр - Структура предприятия'[Подразделение]), LEFT('Спр - Структура предприятия'[Подразделение], 6) = "E-comm")),
    "rev", [# Выручка], "qty", [# Количество], "gp", [# Валовая прибыль]
)
