// Product dictionary: 1C code -> brand, business line, groups
EVALUATE
SELECTCOLUMNS(
    FILTER('Спр - Номенклатура', NOT ISBLANK('Спр - Номенклатура'[Код])),
    "code", 'Спр - Номенклатура'[Код],
    "name", 'Спр - Номенклатура'[Номенклатура],
    "brand", RELATED('Спр - Номенклатура объединенная'[Бренд]),
    "subbrand", RELATED('Спр - Номенклатура объединенная'[Суббренд]),
    "bdir", RELATED('Спр - Номенклатура объединенная'[Бизнес направление]),
    "tgroup", RELATED('Спр - Номенклатура объединенная'[Товарная группа]),
    "g1", RELATED('Спр - Номенклатура объединенная'[Группа-1]),
    "g2", RELATED('Спр - Номенклатура объединенная'[Группа-2]),
    "segment", RELATED('Спр - Номенклатура объединенная'[Аналитический сегмент]),
    "stage", RELATED('Спр - Номенклатура объединенная'[Этап развития])
)
