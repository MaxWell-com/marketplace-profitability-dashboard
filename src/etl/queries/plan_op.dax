// E-comm operating plan (the «План Факт» budget): month x division x analytics
EVALUATE
FILTER(
SUMMARIZECOLUMNS(
    'Факт - План Факт'[Месяц отчетного периода], 'Факт - План Факт'[Статья бюджетов], 'Спр - Структура предприятия'[Подразделение],
    'Факт - План Факт'[Аналитика 1], 'Факт - План Факт'[Аналитика 2], 'Факт - План Факт'[Аналитика 3], 'Факт - План Факт'[Аналитика 4],
    "plan", SUM('Факт - План Факт'[Сумма сценария])
), LEFT([Подразделение], 6) = "E-comm")
