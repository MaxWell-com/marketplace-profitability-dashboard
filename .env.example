# Marketplace profitability dashboard — environment variables. Real values never go into the
# repository: locally use a .env file (git-ignored), in production use your platform's secrets.
# With no variables set at all, the app runs on synthetic demo data.

# ── Data source: demo (default) — synthetic inputs, no infrastructure required;
#    olap — OLAP cube + DWH + finance files (variables below).
DATA_SOURCE=demo
# Demo: pin "today" (YYYY-MM-DD, in 2026: the UI's year selectors are 2025–2026). Default 2026-11-18.
# DEMO_TODAY=2026-11-18

# ── OLAP cube (SSAS Tabular, XMLA over HTTP via msmdpump) — 1C sales, marketplace charges and ads,
#    budget plan, product dimension, own stock. DATA_SOURCE=olap only.
OLAP_URL=
OLAP_USER=
OLAP_PASS=
OLAP_CATALOG=
# OLAP_TIMEOUT_MS=300000
# Upper limit for one cube response; a larger one fails the build with a clear error.
# OLAP_MAX_RESPONSE_MB=400

# ── DWH (MS SQL) — Wildberries/Ozon daily stock, WB search positions and funnel, Ozon campaigns,
#    WB campaign names. DATA_SOURCE=olap only.
DWH_HOST=
DWH_PORT=1433
DWH_DB=
DWH_USER=
DWH_PASS=
# DWH_TIMEOUT_MS=300000

# ── Finance department folder with «Доходность ГГГГ*.xlsx» (required), «Номенклатура.xlsx» and
#    «101 и ТМ отчеты квартал.xlsx», mounted read-only. DATA_SOURCE=olap only.
PEO_DIR=
# Cache of parsed profitability files (by file size and date). Default ./.cache
# CACHE_DIR=/app/.cache

# ── Own product code prefixes (the brands page lists only these), comma-separated. Default NR-.
# OWN_CODE_PREFIXES=NR-

# ── Access. Identity comes from X-Auth-Request-* headers (when an SSO proxy sits in front of the app),
#    otherwise the user is "local". Comma-separated groups, any one is enough; empty — open access.
# REQUIRED_TEAM=

# ── Token for the monitoring endpoints /api/ops/etl and /api/ops/signals. Unset — they answer 503.
# OPS_TOKEN=

# Snapshot TTL, default 3 hours: a stale snapshot is served immediately, a new one is built in the background.
# REPORT_TTL_MS=10800000

PORT=3000
# HOST=0.0.0.0
